{
  "from": "1.1",
  "to": "2.0",
  "breaking": true,
  "removedOperations": [
    {
      "operationId": "login",
      "path": "/auth/login",
      "method": "post",
      "replacement": "beginLogin"
    },
    {
      "operationId": "fulfillOrder",
      "path": "/shops/{shopId}/orders/{orderId}/fulfill",
      "method": "post",
      "replacement": "handoverShipment / recordShipmentEvent"
    },
    {
      "operationId": "returnOrder",
      "path": "/shops/{shopId}/orders/{orderId}/return",
      "method": "post",
      "replacement": "createReturnCase + inspectReturn + separately verified refundOrder"
    }
  ],
  "rules": [
    "Use /api/v2, do not silently reinterpret v1 fulfilled data as delivered.",
    "Old prototype is not an evidence source for actual financial or fulfillment state.",
    "Existing production consumers, if any, require dual-version rollout and approved migration."
  ]
}
