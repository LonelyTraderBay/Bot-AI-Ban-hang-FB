{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:botsales:frontend:layout-exceptions:v1",
  "title": "Frontend layout exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exceptions"],
  "properties": {
    "version": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "selector", "property", "value", "category", "reason", "evidence", "owner", "reviewTrigger"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+" },
          "selector": { "type": "string", "minLength": 1 },
          "property": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "category": { "enum": ["GEOMETRY", "COMPOSITE", "PLATFORM", "A11Y_MECHANISM", "OPTICAL"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reviewTrigger": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
