        "listWarehouses",
        "createWarehouse",
        "getWarehouse",
        "updateWarehouse",
        "archiveWarehouse",
        "listCustomerAddresses",
        "createCustomerAddress",
        "getCustomerAddress",
        "updateCustomerAddress",
        "archiveCustomerAddress",
        "listAccounts",
        "createAccount",
