  "breaking": true,
  "removedOperations": [
    {
      "operationId": "login",
      "path": "/auth/login",
      "method": "post",
      "replacement": "beginLogin"
    },
    {
      "operationId": "fulfillOrder",
      "path": "/shops/{shopId}/orders/{orderId}/fulfill",
      "method": "post",
      "replacement": "handoverShipment / recordShipmentEvent"
    },
    {
      "operationId": "returnOrder",
      "path": "/shops/{shopId}/orders/{orderId}/return",
      "method": "post",
      "replacement": "createReturnCase + inspectReturn + separately verified refundOrder"
