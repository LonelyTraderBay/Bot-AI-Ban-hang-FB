{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true, "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "noEmit": true, "jsx": "react-jsx", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "baseUrl": ".", "paths": {
      "@/*": ["src/*"], "@botsales/contracts": ["../../packages/contracts/src/index.ts"],
      "@botsales/tokens": ["../../packages/design-tokens/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../../packages/contracts/src", "../../packages/design-tokens/src"]
}
