enum FilePurpose {
  product_image
  product_import
  knowledge_source
  bank_statement
  cod_statement
  conversation_media
  report_export
  privacy_export
  preparation_issue_image
  payment_evidence_image

  @@map("file_purpose")
}

enum FileStatus {
  quarantined
  ready
  rejected

  @@map("file_status")
}

enum FileRejectionReason {
  invalid_format
  unsupported_content
  spreadsheet_limit
  unsafe_file
  validation_failed

  @@map("file_rejection_reason")
}

enum FileStorageState {
  pending
  stored
  purged

  @@map("file_storage_state")
}

model AuthLoginAttempt {
  state              String    @id @db.VarChar(43)
  browserHash        String    @map("browser_hash") @db.VarChar(64)
  idempotencyKeyHash String    @map("idempotency_key_hash") @db.VarChar(64)
  returnTo           String    @map("return_to")
  returnToHash       String    @map("return_to_hash") @db.VarChar(64)
  nonce              String?   @db.VarChar(43)
  pkceVerifier       String?   @map("pkce_verifier") @db.VarChar(128)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  stepUpSessionId    String?   @map("step_up_session_id") @db.Uuid
  stepUpShopId       String?   @map("step_up_shop_id") @db.Uuid
  stepUpResourceId   String?   @map("step_up_resource_id") @db.Uuid

  @@unique([browserHash, idempotencyKeyHash])
  @@index([expiresAt])
  @@map("auth_login_attempts")
}

model User {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcIssuer  String?      @map("oidc_issuer")
  oidcSubject String?      @map("oidc_subject")
  displayName String       @map("display_name")
  email       String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  sessions    Session[]
  createdShops ShopCreationIntent[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("users")
}

model Shop {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String        @db.VarChar(160)
  currency           String        @db.VarChar(3)
  businessCountry    String?       @map("business_country") @db.VarChar(2)
  timezone           String
  locale             String
  version            Int           @default(1)
  policyVersion      String        @default("1") @map("policy_version")
  eventSequence      BigInt        @default(0) @map("event_sequence")
  catalogVersion     BigInt        @default(0) @map("catalog_version")
  defaultWarehouseId String        @map("default_warehouse_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(3)
  defaultWarehouse   Warehouse     @relation("DefaultWarehouse", fields: [id, defaultWarehouseId], references: [shopId, id], onDelete: NoAction, onUpdate: NoAction, map: "shops_default_warehouse_fkey")
  warehouses         Warehouse[]   @relation("ShopWarehouses")
  memberships        Membership[]
  auditEntries       AuditEntry[]
  outboxEvents       OutboxEvent[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  stockReservations  StockReservation[]
  shippingPolicy     ShippingPolicy?
  promotions         Promotion[]
  channels           ChannelConnection[]
  channelIntents     ChannelAuthorization[]
  knowledgeDocuments KnowledgeDocument[]
  evaluations        Evaluation[]
  aiConnections      AiConnection[]
  botConfig          BotConfig?
  botUsage           BotDailyUsage[]
  automation         ShopAutomation?
  agentRoles         AgentRole[]
  budgetPolicies     BudgetPolicy[]
  ownerDigests       OwnerDigest[]
  creationIntent     ShopCreationIntent?
  privacyPolicy      PrivacyPolicy?
  accounts           FinanceAccount[]
  periods            AccountingPeriod[]
  openingBalances    OpeningBalance[]
  financeEntries     FinanceEntry[]
  advertisingEstimates AdvertisingEstimate[]
  codSettlements     CodSettlement[]
  workItems          WorkItem[]
  notificationPolicy NotificationPolicy?
  suppliers          Supplier[]
  supplierRoutes     SupplierDispatchRoute[]

  @@map("shops")
}

enum PrivacyRequestKind {
  export
  delete

  @@map("privacy_request_kind")
}

enum PrivacyRequestState {
  pending_approval
  running
  completed
  rejected
  legal_hold
  failed

  @@map("privacy_request_state")
}

enum ConsentChannel {
  messenger
  sms
  email

  @@map("consent_channel")
}

enum ConsentState {
  granted
  withdrawn

  @@map("consent_state")
}

enum ConsentChallengeState {
  pending
  exchanged
  confirmed
  declined
  expired

  @@map("consent_challenge_state")
}

model StepUpGrant {
  tokenHash  String    @id @map("token_hash") @db.VarChar(64)
  sessionId  String    @map("session_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revealedAt DateTime? @map("revealed_at") @db.Timestamptz(3)
  shopId     String?   @map("shop_id") @db.Uuid
  resourceId String?   @map("resource_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sessionId, expiresAt])
  @@map("step_up_grants")
}

model PrivacyPolicy {
  shopId            String   @id @map("shop_id") @db.Uuid
  version           Int      @default(1)
  chatRetentionDays Int?     @map("chat_retention_days")
  jurisdictionNote  String   @default("") @map("jurisdiction_note") @db.VarChar(2000)
  approvedBy        String?  @map("approved_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approver          Membership? @relation("PrivacyPolicyApprover", fields: [shopId, approvedBy], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)

  @@map("privacy_policies")
}

model PrivacyRequest {
  shopId           String    @map("shop_id") @db.Uuid
  id               String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version          Int       @default(1)
  customerId       String    @map("customer_id") @db.Uuid
  kind             PrivacyRequestKind
  status           PrivacyRequestState @default(pending_approval)
  reason           String    @db.VarChar(2000)
  createdBy        String    @map("created_by") @db.Uuid
  approvedBy       String?   @map("approved_by") @db.Uuid
  policyVersion    Int?      @map("policy_version")
  jobId            String?   @map("job_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer         Customer  @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  requester        Membership @relation("PrivacyRequester", fields: [shopId, createdBy], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)
  approver         Membership? @relation("PrivacyApprover", fields: [shopId, approvedBy], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)
  job              Job?      @relation(fields: [shopId, jobId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  consents         ConsentEvidence[]

  @@id([shopId, id])
  @@unique([shopId, jobId])
  @@index([shopId, createdAt, id])
  @@index([shopId, customerId, kind, status])
  @@map("privacy_requests")
}

model CustomerConsent {
  shopId          String    @map("shop_id") @db.Uuid
  id              String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  channel         ConsentChannel
  version         Int       @default(1)
  status          ConsentState
  policyVersion   String    @map("policy_version") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        Customer  @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  history         ConsentEvidence[]
  confirmations   ConsentChallenge[]

  @@id([shopId, id])
  @@unique([shopId, customerId, channel])
  @@index([shopId, createdAt, id])
  @@map("customer_consents")
}

model ConsentChallenge {
  shopId          String    @map("shop_id") @db.Uuid
  id              String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  actorId         String    @map("actor_id") @db.Uuid
  channel         ConsentChannel
  withdraw        Boolean   @default(false)
  status          ConsentChallengeState @default(pending)
  version         Int       @default(1)
  message         String    @db.VarChar(2000)
  contentVersion  Int       @map("content_version")
  policyVersion   String    @map("policy_version") @db.VarChar(100)
  priorConsentVersion Int   @default(0) @map("prior_consent_version")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  exchangeHash    String?   @map("exchange_hash") @db.VarChar(64)
  confirmationHash String?  @map("confirmation_hash") @db.VarChar(64)
  consentId       String?   @map("consent_id") @db.Uuid
  resultVersion   Int?      @map("result_version")
  resultStatus    ConsentState? @map("result_status")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        Customer  @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  actor           Membership @relation(fields: [shopId, actorId], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)
  consent         CustomerConsent? @relation(fields: [shopId, consentId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  evidence        ConsentEvidence[]

  @@id([shopId, id])
  @@index([shopId, createdAt, id])
  @@index([shopId, customerId, channel, status])
  @@map("consent_challenges")
}

model ConsentEvidence {
  shopId          String        @map("shop_id") @db.Uuid
  id              String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consentId       String        @map("consent_id") @db.Uuid
  challengeId     String?       @map("challenge_id") @db.Uuid
  privacyRequestId String?      @map("privacy_request_id") @db.Uuid
  recoveryAuditId String?       @map("recovery_audit_id") @db.Uuid
  contentVersion  Int?          @map("content_version")
  action          String        @db.VarChar(20)
  occurredAt      DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  consent         CustomerConsent @relation(fields: [shopId, consentId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  challenge       ConsentChallenge? @relation(fields: [shopId, challengeId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  privacyRequest  PrivacyRequest? @relation(fields: [shopId, privacyRequestId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  recoveryAudit   AuditEntry?  @relation(fields: [shopId, recoveryAuditId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, id])
  @@unique([shopId, challengeId, action])
  @@unique([shopId, privacyRequestId, consentId])
  @@unique([shopId, recoveryAuditId, consentId])
  @@index([shopId, consentId, occurredAt, id])
  @@map("consent_evidence")
}

model ShopCreationIntent {
  actorId        String   @map("actor_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  shopId         String   @unique @map("shop_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([actorId, idempotencyKey])
  @@map("shop_creation_intents")
}

model Customer {
  shopId         String            @map("shop_id") @db.Uuid
  id             String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName    String            @map("display_name") @db.VarChar(160)
  phone          String?           @db.VarChar(40)
  email          String?
  notes          String?
  redactedFields String[]          @default([]) @map("redacted_fields")
  privacyErasedAt DateTime?         @map("privacy_erased_at") @db.Timestamptz(3)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identities     CustomerIdentity[]
  addresses      CustomerAddress[]
  serviceCases   ServiceCase[]
  orders         SalesOrder[]
  privacyRequests PrivacyRequest[]
  consents         CustomerConsent[]
  consentChallenges ConsentChallenge[]

  @@id([shopId, id])
  @@index([shopId, createdAt, id])
  @@map("customers")
}

model CustomerIdentity {
  shopId     String   @map("shop_id") @db.Uuid
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  channel    String   @db.VarChar(40)
  pageId     String   @map("page_id") @db.VarChar(160)
  externalId String   @map("external_id") @db.VarChar(160)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  conversations ChannelConversation[]
  confirmations OrderCustomerConfirmation[]

  @@id([shopId, channel, pageId, externalId])
  @@unique([shopId, id])
  @@unique([shopId, customerId, id])
  @@index([shopId, customerId])
  @@map("customer_identities")
}

model CustomerAddress {
  shopId         String         @map("shop_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label          String?        @db.VarChar(120)
  recipient      String?        @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  line1          String?        @db.VarChar(500)
  ward           String?        @db.VarChar(120)
  district       String?        @db.VarChar(120)
  province       String?        @db.VarChar(120)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  countryCode    String?        @map("country_code") @db.VarChar(2)
  status         AddressStatus  @default(active)
  redactedFields String[]       @default([]) @map("redacted_fields")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer       Customer      @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshots      AddressSnapshot[]
  orders         SalesOrder[]

  @@id([shopId, customerId, id])
  @@index([shopId, customerId, createdAt, id])
  @@map("customer_addresses")
}

model AddressSnapshot {
  shopId         String   @map("shop_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  id             String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  addressId      String   @map("address_id") @db.Uuid
  addressVersion Int      @map("address_version")
  data           Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  address        CustomerAddress @relation(fields: [shopId, customerId, addressId], references: [shopId, customerId, id], onDelete: Restrict, onUpdate: NoAction)
  quotes         OrderQuote[]

  @@id([shopId, id])
  @@unique([shopId, customerId, addressId, addressVersion], map: "address_snapshots_source_version_key")
  @@map("address_snapshots")
}

model ServiceCase {
  shopId     String           @map("shop_id") @db.Uuid
  id         String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  orderId    String?          @map("order_id") @db.Uuid
  workItemId String?          @map("work_item_id") @db.Uuid
  kind       ServiceCaseKind
  state      ServiceCaseState @default(open)
  summary    String           @db.VarChar(2000)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer         @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  order      SalesOrder?      @relation(fields: [shopId, customerId, orderId], references: [shopId, customerId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, id])
  @@index([shopId, createdAt, id])
  @@index([shopId, customerId])
