generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  sales
  warehouse
  accountant
  bot_admin
  viewer

  @@map("membership_role")
}

enum MembershipStatus {
  active
  invited
  revoked

  @@map("membership_status")
}

enum WarehouseStatus {
  active
  archived

  @@map("warehouse_status")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum PromotionStatus {
  draft
  active
  paused

  @@map("promotion_status")
}

enum OrderState {
  draft
  confirmed
  completed
  cancelled

  @@map("order_state")
}

enum OrderFulfillmentState {
  unfulfilled
  reserved
  picking
  packed
  dispatched
  part_delivered
  delivered
  part_returned
  returned

  @@map("order_fulfillment_state")
}

enum OrderPaymentState {
  unpaid
  part_paid
  verified
  cod_collected
  settled
  part_refunded
  refunded

  @@map("order_payment_state")
}

enum OrderPaymentMethod {
  prepay
  cod

  @@map("order_payment_method")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageOrigin {
  fixture
  provider

  @@map("message_origin")
}

enum ConversationStatus {
  open
  resolved

  @@map("conversation_status")
}

enum ConversationMode {
  human
  bot
  paused

  @@map("conversation_mode")
}

enum AccountGroup {
  asset
  liability
  equity
  income
  expense

  @@map("account_group")
}

enum AccountStatus {
  active
  archived

  @@map("account_status")
}

enum AccountingPeriodState {
  open
  closing
  closed

  @@map("accounting_period_state")
}

enum PostingStatus {
  draft
  posted
  reversed

  @@map("posting_status")
}

enum FinanceEntryKind {
  receipt
  disbursement

  @@map("finance_entry_kind")
}

enum FinanceClassification {
  sales_receipt
  inventory_purchase
  shipping
  platform_fee
  payment_fee
  ai_expense
  operating_expense
  capital
  loan_principal
  transfer
  other

  @@map("finance_classification")
}

enum PaymentEvidenceKind {
  cash_receipt
  bank_receipt
  provider_receipt
  carrier_collection
  observed_refund

  @@map("payment_evidence_kind")
}

enum StockMovementKind {
  receipt
  adjustment
  reserve
  release
  fulfillment
  return
  transfer_out
  transfer_in

  @@map("stock_movement_kind")
}

enum StockReservationStatus {
  active
  released
  expired
  consumed

  @@map("stock_reservation_status")
}

enum JobKind {
  import
  export
  knowledge_index
  evaluation
  privacy
  connection_test

  @@map("job_kind")
}

enum JobStatus {
  queued
  running
  awaiting_confirmation
  succeeded
  partial
  failed
  cancelled

  @@map("job_status")
}

enum AddressStatus {
  active
  archived

  @@map("address_status")
}

enum ServiceCaseKind {
  question
  complaint
  return_request
  delivery_issue

  @@map("service_case_kind")
}

enum ServiceCaseState {
  open
  assigned
  resolved
  closed

  @@map("service_case_state")
}

enum FilePurpose {
  product_image
  product_import
  knowledge_source
  bank_statement
  cod_statement
  conversation_media

  @@map("file_purpose")
}

enum FileStatus {
  quarantined
  ready
  rejected

  @@map("file_status")
}

model AuthLoginAttempt {
  state              String    @id @db.VarChar(43)
  browserHash        String    @map("browser_hash") @db.VarChar(64)
  idempotencyKeyHash String    @map("idempotency_key_hash") @db.VarChar(64)
  returnTo           String    @map("return_to")
  returnToHash       String    @map("return_to_hash") @db.VarChar(64)
  nonce              String?   @db.VarChar(43)
  pkceVerifier       String?   @map("pkce_verifier") @db.VarChar(128)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@unique([browserHash, idempotencyKeyHash])
  @@index([expiresAt])
  @@map("auth_login_attempts")
}

model User {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcIssuer  String?      @map("oidc_issuer")
  oidcSubject String?      @map("oidc_subject")
  displayName String       @map("display_name")
  email       String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  sessions    Session[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("users")
}

model Shop {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String        @db.VarChar(160)
  currency           String        @db.VarChar(3)
  timezone           String
  locale             String
  version            Int           @default(1)
  policyVersion      String        @default("1") @map("policy_version")
  eventSequence      BigInt        @default(0) @map("event_sequence")
  catalogVersion     BigInt        @default(0) @map("catalog_version")
  defaultWarehouseId String        @map("default_warehouse_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  defaultWarehouse   Warehouse     @relation("DefaultWarehouse", fields: [id, defaultWarehouseId], references: [shopId, id], onDelete: NoAction, onUpdate: NoAction, map: "shops_default_warehouse_fkey")
  warehouses         Warehouse[]   @relation("ShopWarehouses")
  memberships        Membership[]
  auditEntries       AuditEntry[]
  outboxEvents       OutboxEvent[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  stockReservations  StockReservation[]
  shippingPolicy     ShippingPolicy?
  promotions         Promotion[]
  channels           ChannelConnection[]
  accounts           FinanceAccount[]
  periods            AccountingPeriod[]
  openingBalances    OpeningBalance[]
  financeEntries     FinanceEntry[]

  @@map("shops")
}

model Customer {
  shopId         String            @map("shop_id") @db.Uuid
  id             String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName    String            @map("display_name") @db.VarChar(160)
  phone          String?           @db.VarChar(40)
  email          String?
  notes          String?
  redactedFields String[]          @default([]) @map("redacted_fields")
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identities     CustomerIdentity[]
  addresses      CustomerAddress[]
  serviceCases   ServiceCase[]
  orders         SalesOrder[]

  @@id([shopId, id])
  @@index([shopId, createdAt, id])
  @@map("customers")
}

model CustomerIdentity {
  shopId     String   @map("shop_id") @db.Uuid
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  channel    String   @db.VarChar(40)
  pageId     String   @map("page_id") @db.VarChar(160)
  externalId String   @map("external_id") @db.VarChar(160)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  conversations ChannelConversation[]
  confirmations OrderCustomerConfirmation[]

  @@id([shopId, channel, pageId, externalId])
  @@unique([shopId, id])
  @@unique([shopId, customerId, id])
  @@index([shopId, customerId])
  @@map("customer_identities")
}

model CustomerAddress {
  shopId         String         @map("shop_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label          String?        @db.VarChar(120)
  recipient      String?        @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  line1          String?        @db.VarChar(500)
  ward           String?        @db.VarChar(120)
  district       String?        @db.VarChar(120)
  province       String?        @db.VarChar(120)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  countryCode    String?        @map("country_code") @db.VarChar(2)
  status         AddressStatus  @default(active)
  redactedFields String[]       @default([]) @map("redacted_fields")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer       Customer      @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshots      AddressSnapshot[]
  orders         SalesOrder[]

  @@id([shopId, customerId, id])
  @@index([shopId, customerId, createdAt, id])
  @@map("customer_addresses")
}

model AddressSnapshot {
  shopId         String   @map("shop_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  id             String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  addressId      String   @map("address_id") @db.Uuid
  addressVersion Int      @map("address_version")
  data           Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  address        CustomerAddress @relation(fields: [shopId, customerId, addressId], references: [shopId, customerId, id], onDelete: Restrict, onUpdate: NoAction)
  quotes         OrderQuote[]

  @@id([shopId, id])
  @@unique([shopId, customerId, addressId, addressVersion], map: "address_snapshots_source_version_key")
  @@map("address_snapshots")
}

model ServiceCase {
  shopId     String           @map("shop_id") @db.Uuid
  id         String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  orderId    String?          @map("order_id") @db.Uuid
  workItemId String?          @map("work_item_id") @db.Uuid
  kind       ServiceCaseKind
  state      ServiceCaseState @default(open)
  summary    String           @db.VarChar(2000)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer         @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  order      SalesOrder?      @relation(fields: [shopId, customerId, orderId], references: [shopId, customerId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, id])
  @@index([shopId, createdAt, id])
  @@index([shopId, customerId])
  @@map("service_cases")
}

model Category {
  shopId    String    @map("shop_id") @db.Uuid
  id        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  parentId  String?   @map("parent_id") @db.Uuid
  active    Boolean   @default(true)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parent    Category? @relation("CategoryTree", fields: [shopId, parentId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@id([shopId, id])
  @@index([shopId, parentId])
  @@index([shopId, createdAt, id])
  @@map("categories")
}

model Product {
  shopId      String        @map("shop_id") @db.Uuid
  id          String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(160)
  description String
  categoryId  String?       @map("category_id") @db.Uuid
  status      ProductStatus @default(draft)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category    Category?     @relation(fields: [shopId, categoryId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  variants    Variant[]
  images      ProductImage[]

  @@id([shopId, id])
  @@index([shopId, categoryId])
  @@index([shopId, createdAt, id])
  @@map("products")
}

model Variant {
  shopId        String   @map("shop_id") @db.Uuid
  id            String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @db.VarChar(80)
  skuKey        String   @map("sku_key")
  name          String   @db.VarChar(160)
  options       Json
  priceAmount   Decimal  @map("price_amount") @db.Decimal(78, 18)
  priceCurrency String   @map("price_currency") @db.VarChar(3)
  active        Boolean  @default(true)
  position      Int
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product       Product  @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  stockPositions StockPosition[]
  promotionLines PromotionLine[]
  orderLines OrderLine[]

  @@id([shopId, id])
  @@unique([shopId, skuKey])
  @@index([shopId, productId, position])
  @@map("variants")
}

model ShippingPolicy {
  shopId    String   @id @map("shop_id") @db.Uuid
  version   Int      @default(1)
  rules     Json
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("shipping_policies")
}

model Promotion {
  shopId           String          @map("shop_id") @db.Uuid
  id               String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version          Int             @default(1)
  name             String          @db.VarChar(120)
  startsOn         DateTime        @map("starts_on") @db.Date
  endsOn           DateTime        @map("ends_on") @db.Date
  discountAmount   Decimal         @map("discount_amount") @db.Decimal(16, 4)
  minMarginPercent Int             @map("min_margin_percent")
  status           PromotionStatus @default(draft)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop             Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines            PromotionLine[]

  @@id([shopId, id])
  @@index([shopId, status, startsOn, endsOn])
  @@index([shopId, createdAt, id])
  @@map("promotions")
}

model PromotionLine {
  shopId      String    @map("shop_id") @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  variantId   String    @map("variant_id") @db.Uuid
  quantity    Int
  sku         String    @db.VarChar(160)
  label       String    @db.VarChar(500)
  position    Int
  promotion   Promotion @relation(fields: [shopId, promotionId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  variant     Variant   @relation(fields: [shopId, variantId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, promotionId, variantId])
  @@unique([shopId, promotionId, position])
  @@map("promotion_lines")
}

model Warehouse {
  shopId      String          @map("shop_id") @db.Uuid
  id          String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String          @db.VarChar(40)
  name        String          @db.VarChar(160)
  addressLine String          @map("address_line") @db.VarChar(500)
  status      WarehouseStatus @default(active)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop        Shop            @relation("ShopWarehouses", fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  defaultFor  Shop[]          @relation("DefaultWarehouse")
  stockPositions StockPosition[]
  orders      SalesOrder[]

  @@id([shopId, id])
  @@unique([shopId, code])
  @@map("warehouses")
}

model StockPosition {
  shopId            String      @map("shop_id") @db.Uuid
  id                String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId       String      @map("warehouse_id") @db.Uuid
  variantId         String      @map("variant_id") @db.Uuid
  onHand            Int         @default(0) @map("on_hand")
  reserved          Int         @default(0)
  quarantine        Int         @default(0)
  transit           Int         @default(0)
  inbound           Int         @default(0)
  carryingValue     Decimal     @default(0) @map("carrying_value") @db.Decimal(78, 18)
  lowStockThreshold Int         @default(0) @map("low_stock_threshold")
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  warehouse         Warehouse   @relation(fields: [shopId, warehouseId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  variant           Variant     @relation(fields: [shopId, variantId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  movements         StockMovement[]
  reservationLines  StockReservationLine[]

  @@id([shopId, id])
  @@unique([shopId, warehouseId, variantId])
  @@index([shopId, variantId, warehouseId])
  @@index([shopId, createdAt, id])
  @@map("stock_positions")
}

model StockMovement {
  shopId          String            @map("shop_id") @db.Uuid
  id              String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  variantId       String            @map("variant_id") @db.Uuid
  sku             String            @db.VarChar(80)
  actorId         String            @map("actor_id") @db.Uuid
  kind            StockMovementKind
  sourceType      String            @map("source_type") @db.VarChar(64)
  sourceId        String            @map("source_id") @db.Uuid
  sourceLineId    String            @map("source_line_id") @db.Uuid
  requestHash     String            @map("request_hash") @db.VarChar(64)
  reason          String            @db.VarChar(1000)
  quantityDelta   Int               @map("quantity_delta")
  reservedDelta   Int               @map("reserved_delta")
  quarantineDelta Int               @map("quarantine_delta")
  transitDelta    Int               @map("transit_delta")
  inboundDelta    Int               @map("inbound_delta")
  carryingDelta   Decimal           @map("carrying_delta") @db.Decimal(78, 18)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  position        StockPosition     @relation(fields: [shopId, warehouseId, variantId], references: [shopId, warehouseId, variantId], onDelete: Restrict, onUpdate: NoAction)
  actor           Membership        @relation(fields: [shopId, actorId], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, id])
  @@unique([shopId, sourceType, sourceId, sourceLineId, kind], map: "stock_movements_source_key")
  @@index([shopId, createdAt, id])
  @@index([shopId, warehouseId, variantId, createdAt, id])
  @@map("stock_movements")
}

model StockReservation {
  shopId       String                 @map("shop_id") @db.Uuid
  id           String                 @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String                 @map("order_id") @db.Uuid
  orderVersion Int                    @map("order_version")
  actorId      String                 @map("actor_id") @db.Uuid
  requestHash  String                 @map("request_hash") @db.VarChar(64)
  status       StockReservationStatus @default(active)
  version      Int                    @default(1)
  expiresAt    DateTime               @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt    DateTime?              @map("settled_at") @db.Timestamptz(3)
  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor        Membership             @relation(fields: [shopId, actorId], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)
  lines        StockReservationLine[]
  salesOrder   SalesOrder?

  @@id([shopId, id])
  @@unique([shopId, orderId, orderVersion])
  @@index([status, expiresAt, shopId, id])
  @@map("stock_reservations")
}

model StockReservationLine {
  shopId        String           @map("shop_id") @db.Uuid
  reservationId String           @map("reservation_id") @db.Uuid
  lineId        String           @map("line_id") @db.Uuid
  warehouseId   String           @map("warehouse_id") @db.Uuid
  variantId     String           @map("variant_id") @db.Uuid
  quantity      Int
  reservation   StockReservation @relation(fields: [shopId, reservationId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  position      StockPosition    @relation(fields: [shopId, warehouseId, variantId], references: [shopId, warehouseId, variantId], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, reservationId, lineId])
  @@index([shopId, warehouseId, variantId])
  @@map("stock_reservation_lines")
}

model ChannelConnection {
  shopId       String                @map("shop_id") @db.Uuid
  id           String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String                @db.VarChar(40)
  pageId       String                @map("page_id") @db.VarChar(160)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversations ChannelConversation[]

  @@id([shopId, id])
  @@unique([shopId, provider, pageId])
  @@map("channel_connections")
}

model ChannelConversation {
  shopId             String           @map("shop_id") @db.Uuid
  id                 String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String           @map("customer_id") @db.Uuid
  customerIdentityId String           @map("customer_identity_id") @db.Uuid
  channelId          String           @map("channel_id") @db.Uuid
  assignedUserId     String?          @map("assigned_user_id") @db.Uuid
  externalId         String           @map("external_id") @db.VarChar(160)
  status             ConversationStatus @default(open)
  mode               ConversationMode @default(paused)
  unreadCount        Int              @default(0) @map("unread_count")
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  identity           CustomerIdentity @relation(fields: [shopId, customerId, customerIdentityId], references: [shopId, customerId, id], onDelete: Restrict, onUpdate: NoAction)
  channel            ChannelConnection @relation(fields: [shopId, channelId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  assignee           Membership?      @relation(fields: [shopId, assignedUserId], references: [shopId, userId], onDelete: Restrict, onUpdate: NoAction)
  orders             SalesOrder[]
  messages           ChannelMessage[]

  @@id([shopId, id])
  @@unique([shopId, customerId, id])
  @@unique([shopId, customerIdentityId, externalId])
  @@index([shopId, customerId, createdAt, id])
  @@index([shopId, createdAt, id])
  @@map("channel_conversations")
}

