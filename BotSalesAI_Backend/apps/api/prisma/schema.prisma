  importCommit      ProductImportPreview? @relation("ImportCommitJob")

  @@id([shopId, id])
  @@unique([shopId, commandId])
  @@index([shopId, actorId, createdAt, id])
  @@index([status, dueAt, id])
  @@index([status, leaseUntil])
  @@map("jobs")
}

model ProductImportPreview {
  shopId         String   @map("shop_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  token          String   @db.VarChar(64)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  catalogVersion BigInt  @map("catalog_version")
  rows           Json
  commitJobId    String?  @map("commit_job_id") @db.Uuid
  job            Job      @relation("ImportPreviewJob", fields: [shopId, jobId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)
  commitJob      Job?     @relation("ImportCommitJob", fields: [shopId, commitJobId], references: [shopId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([shopId, jobId])
  @@unique([shopId, commitJobId])
  @@map("product_import_previews")
}
