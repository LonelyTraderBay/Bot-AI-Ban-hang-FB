generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  sales
  warehouse
  accountant
  bot_admin
  viewer

  @@map("membership_role")
}

enum MembershipStatus {
  active
  invited
  revoked

  @@map("membership_status")
}

enum WarehouseStatus {
  active
  archived

  @@map("warehouse_status")
}

enum ProductStatus {
  draft
  active
  archived

