{
  "name": "botsales-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.22.3",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "start:worker": "node --env-file-if-exists=.env apps/worker/src/main.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env apps/api/prisma/seed.mjs",
    "dev:idp": "node --env-file-if-exists=.env infra/p0/oidc/idp.mjs",
    "dev:frontend:https": "node --env-file-if-exists=.env infra/p0/oidc/dev-live.mjs",
    "build": "npm run db:generate && tsc -p apps/api/tsconfig.json",
    "typecheck": "npm run db:generate && tsc -p apps/api/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:postgres": "node --env-file-if-exists=.env --test tests/integration/database/postgres.test.mjs",
    "test:oidc": "node --env-file-if-exists=.env --test tests/integration/auth/auth.test.mjs",
    "test:oidc:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs",
    "test:pilot:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --pilot",
    "test:release:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --release",
    "test:workspace": "node --env-file-if-exists=.env --test tests/integration/workspace/shops.test.mjs",
    "test:workspace:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --workspace",
    "test:catalog": "node --env-file-if-exists=.env --test tests/integration/catalog/catalog.test.mjs",
    "test:object-storage": "node --env-file-if-exists=.env --test tests/integration/catalog/object-storage.test.mjs",
    "test:imports": "node --env-file-if-exists=.env --test tests/integration/catalog/imports.test.mjs",
    "test:inventory": "node --env-file-if-exists=.env --test tests/integration/inventory/inventory.test.mjs",
    "test:procurement": "node --env-file-if-exists=.env --test tests/integration/procurement/procurement.test.mjs",
    "test:inbox": "node --env-file-if-exists=.env --test tests/integration/inbox/inbox.test.mjs",
    "test:ai": "node --env-file-if-exists=.env --test tests/integration/ai/ai.test.mjs",
    "test:operations": "node --env-file-if-exists=.env --test tests/integration/operations/operations.test.mjs",
    "test:privacy": "node --env-file-if-exists=.env --test tests/integration/privacy/privacy.test.mjs",
    "test:orders": "node --env-file-if-exists=.env --test tests/integration/orders/orders.test.mjs",
    "test:finance": "node --env-file-if-exists=.env --test tests/integration/finance/finance.test.mjs",
    "test:customers": "node --env-file-if-exists=.env --test tests/integration/customers/customers.test.mjs",
    "test:catalog:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --catalog",
    "test:imports:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --imports",
    "test:inventory:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --inventory",
    "test:inventory-documents:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --inventory-documents",
    "test:orders:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --orders",
    "test:fulfillment:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --fulfillment",
    "test:promotions:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --promotions",
    "test:procurement:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --procurement",
    "test:finance:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --finance",
    "test:reconciliation:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --reconciliation",
    "test:inbox:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --inbox",
    "test:ai:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --ai",
    "test:operations:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --operations",
    "test:privacy:browser": "node --env-file-if-exists=.env tests/integration/auth/browser-smoke.mjs --privacy",
    "test:events": "node --env-file-if-exists=.env --test tests/integration/workers/events.test.mjs",
    "test:jobs": "node --env-file-if-exists=.env --test tests/integration/workers/jobs.test.mjs",
    "verify:matrix": "node scripts/check-matrix.mjs",
    "package:release": "npm run db:generate && npm --prefix ../BotSalesAI_Frontend run build && node scripts/package-release.mjs",
    "check:staging": "node --env-file-if-exists=.env scripts/check-staging.mjs",
    "record:procurement-evidence": "node --env-file-if-exists=.env scripts/record-procurement-evidence.mjs",
    "record:shipment-evidence": "node --env-file-if-exists=.env scripts/record-shipment-evidence.mjs",
    "record:advertising-estimate": "node --env-file-if-exists=.env scripts/record-advertising-estimate-evidence.mjs",
    "check:staging-data": "node --env-file-if-exists=.env scripts/check-staging-data.mjs",
    "check:object-storage": "node --env-file-if-exists=.env scripts/check-object-storage.mjs",
    "check:oidc-provider": "node --env-file-if-exists=.env scripts/check-oidc-provider.mjs",
    "eval:staging-ai": "node --env-file-if-exists=.env scripts/evaluate-staging-ai.mjs",
    "check:release-runtime": "node --env-file-if-exists=.env scripts/check-release-runtime.mjs",
    "check:operations": "node --env-file-if-exists=.env scripts/check-operations.mjs",
    "test:load:local": "node --env-file-if-exists=.env scripts/measure-local.mjs",
    "test:recovery:local": "node --env-file-if-exists=.env tests/recovery/local-postgres-smoke.mjs",
    "test:recovery:privacy": "node --env-file-if-exists=.env tests/recovery/privacy-pitr-fixture.mjs",
    "test:recovery:privacy-replay": "node --env-file-if-exists=.env tests/recovery/privacy-replay.mjs",
    "recovery:privacy": "node --env-file-if-exists=.env infra/backup/privacy-recovery.mjs",
    "check:restore-evidence": "node infra/backup/check-restore-evidence.mjs",
    "verify": "npm run lint && npm run db:validate && npm run build && npm run verify:matrix && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "oidc-provider": "9.15.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
