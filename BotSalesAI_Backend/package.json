{
  "name": "botsales-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.22.3",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "build": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify:matrix": "node scripts/check-matrix.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run verify:matrix && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
